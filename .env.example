DATABASE_URL=postgres://pulsar:pulsar@localhost:5432/pulsar
NATS_URL=nats://localhost:4222
SCYLLA_URL=localhost:9042
REDIS_URL=redis://localhost:6379

# Master encryption key (e.g. openssl rand -hex 32)
KEK_SECRET=<your-64-hex-char-key-here>

# Must be at least 32 characters (e.g. openssl rand -hex 32)
JWT_SECRET=change-me-in-production-min-32-chars

# Comma-separated list of allowed client origins (no trailing slash)
# Add your Orbit instance URL here (e.g. https://orbit.yourdomain.com)
ALLOWED_ORIGINS=http://localhost:5173

HOST=0.0.0.0
PORT=3000

STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=pulsar-uploads
STORAGE_ACCESS_KEY=pulsar
STORAGE_SECRET_KEY=pulsarsecret
STORAGE_PUBLIC_URL=http://localhost:9000/pulsar-uploads

# LIVEKIT_URL must be the public IP/domain of the VPS — the browser connects to it directly
LIVEKIT_URL=ws://YOUR_VPS_IP:7880
LIVEKIT_API_KEY=devkey
# Secret must be at least 32 characters (e.g. openssl rand -hex 32)
LIVEKIT_API_SECRET=secret-must-be-at-least-32-characters-long

# Unique integer per process instance (0-1023). Must differ between
# each running pulsar-api and pulsar-gateway process to avoid Snowflake ID collisions.
WORKER_ID=0
